{
  "name": "brand-style-kit",
  "version": "0.1.0",
  "private": true,
  "description": "输入网址，在本地提取网站主色板、字体栈与 Logo 的轻量桌面工具（不依赖账号、不调用大模型）",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "build:engine": "node scripts/build-engine.cjs",
    "dev": "npm run build:engine && vite",
    "build:renderer": "npm run build:engine && vite build",
    "preview": "vite preview",
    "pack:dir": "npm run build:renderer && electron-builder --win dir",
    "pack:nsis": "npm run build:renderer && electron-builder --win nsis",
    "test": "node scripts/test-logic.cjs && node scripts/test-fonts.cjs && node scripts/test-engine.cjs && node scripts/test-ai.cjs && node scripts/test-export.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.10",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8"
  },
  "build": {
    "appId": "com.local.brandstylekit",
    "productName": "网站风格提取器",
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "网站风格提取器-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "网站风格提取器",
      "deleteAppDataOnUninstall": false,
      "artifactName": "网站风格提取器-安装版-Setup-${version}.${ext}"
    }
  }
}
